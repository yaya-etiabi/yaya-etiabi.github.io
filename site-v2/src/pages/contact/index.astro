---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site';
---
<BaseLayout title="Contact" description="Contact Yaya Etiabi for research, teaching and professional collaborations.">
  <section class="page-hero"><div class="container"><div class="eyebrow">Contact</div><h1>Get in touch</h1><p class="lead">For research collaborations, academic activities or professional enquiries, LinkedIn is the easiest way to contact me.</p></div></section>
  <section class="section"><div class="container">
    <div class="contact-links">
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={site.scholar} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a>
      <a href={site.orcid} target="_blank" rel="noopener noreferrer">ORCID ↗</a>
    </div>
  </div></section>
</BaseLayout>