---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getCollection } from 'astro:content';
import { withBase, site } from '../lib/site';
import { Image } from 'astro:assets';
import portrait from '../assets/profile_img.jpg';

const projects = (await getCollection('projects')).sort((a,b) => a.data.sortOrder - b.data.sortOrder);
const featured = projects.filter(p=>p.data.featured).slice(0,3);
const publications = (await getCollection('publications')).filter(p=>p.data.featured).sort((a,b)=>b.data.year-a.data.year).slice(0,3);
const areas = [
  {number:'01', title:'Collaborative & Privacy-Preserving ML',description:'Distributed learning, adaptation and communication-efficient knowledge exchange in wireless networks.'},
  {number:'02',title:'Wireless Sensing & Localization',description:'Learning from radio measurements and sensor observations for localization and environmental understanding.'},
  {number:'03',title:'Edge Intelligence & ISCC',description:'Joint consideration of sensing, communication and computation for intelligence at the network edge.'},
];
---
<BaseLayout>
  <section class="hero personal-hero">
    <div class="container hero-grid personal-hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Research · Machine Learning · Wireless Systems</div>
        <h1>Yaya Etiabi <span class="hero-degree">PhD</span></h1>
        <p class="hero-role">Machine Learning Researcher</p>
        <p class="lead">I work on machine learning methods for wireless sensing, localization and edge intelligence, with an emphasis on collaborative learning and resource-constrained systems.</p>
        <p class="muted">My research spans federated meta-learning and distillation, radio-based estimation and localization, and the co-design of sensing, communication and computation.</p>
        <div class="hero-links" aria-label="Explore this research website">
          <a href={withBase('/research/')}>Research <span aria-hidden="true">↗</span></a>
          <a href={withBase('/publications/')}>Publications <span aria-hidden="true">↗</span></a>
          <a href={withBase('/cv/')}>CV <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-profiles">
          <a href={site.scholar}>Google Scholar</a>
          <span aria-hidden="true">·</span>
          <a href={site.github}>GitHub</a>
          <span aria-hidden="true">·</span>
          <a href={site.linkedin}>LinkedIn</a>
        </div>
      </div>
      <figure class="hero-portrait">
        <Image src={portrait} alt="Portrait of Yaya Etiabi" width={480} format="webp" quality={80} loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow section-label">Research directions</div><h2>Questions that connect my work</h2><p>From collaborative learning to radio perception, my research explores how intelligent systems can operate effectively with distributed, imperfect and resource-constrained data.</p></div><a class="link-arrow" href={withBase('/research/')}>Research overview ↗</a></div>
      <div class="grid-3">{areas.map(area=><article class="card"><div class="kicker">{area.number} / Research area</div><h3>{area.title}</h3><p>{area.description}</p></article>)}</div>
    </div>
  </section>

  <section class="section soft-section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow section-label">Selected work</div><h2>Research in practice</h2><p>Technical work presented with its problem setting, scientific contribution, evaluation and related resources.</p></div><a class="link-arrow" href={withBase('/projects/')}>All projects ↗</a></div>
      <div class="grid-3">{featured.map((project,index)=><ProjectCard slug={project.id} title={project.data.title} summary={project.data.summary} status={project.data.status} period={project.data.period} tags={project.data.tags} index={index}/>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow section-label">Research outputs</div><h2>Selected publications</h2><p>Peer-reviewed work in machine learning, distributed systems and wireless localization.</p></div><a class="link-arrow" href={withBase('/publications/')}>Full publication list ↗</a></div>
      <ul class="pub-list">{publications.map(p=><PublicationItem {...p.data}/>)}</ul>
    </div>
  </section>

  <section class="section soft-section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow section-label">Beyond research</div><h2>Engineering, teaching, and scientific service</h2><p>My background spans electrical engineering, research software and experimental machine learning, alongside teaching, mentoring and peer review.</p></div><a class="button secondary" href={withBase('/about/')}>About my background ↗</a></div>
    </div>
  </section>
</BaseLayout>
